{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared defaults for every repo in config.js",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "assignees": [
    "bradfordwagner"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version pins annotated with `# renovate: datasource=<ds> depName=<dep> [versioning=<v>] [extractVersion=<re>]` on the line above",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n[^\\n:]*:\\s*[\"']?(?<currentValue>[^\\s\"']+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Dagger CLI version in workflows: `DAGGER_VERSION=<x.y.z>` in a run line, or `DAGGER_VERSION: <x.y.z>` in env",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "DAGGER_VERSION[=:]\\s*['\"]?(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "dagger/dagger",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Dagger modules called in workflows via `dagger -m https://github.com/<owner>/<repo>@<tag>`",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "dagger\\s+-m\\s+https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+)@(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
