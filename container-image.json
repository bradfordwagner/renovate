{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Custom container images: tracks the upstream base image in config.yaml",
  "extends": [
    "github>bradfordwagner/renovate"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Base image in config.yaml `upstream`; tags are only published per OS as <version>-<os>",
      "managerFilePatterns": [
        "/^config\\.yaml$/"
      ],
      "matchStrings": [
        "upstream:\\s*\\n\\s+repo:\\s*(?<depName>\\S+)\\s*\\n\\s+tag:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)-"
    }
  ]
}
